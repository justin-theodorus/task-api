# Copy to .env and adjust. .env is gitignored: real credentials never belong in the repo.
#   cp .env.example .env

# Credentials for the Postgres container. Compose reads these to create the database on first run.
POSTGRES_USER=tasks
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=tasks

# Host ports. Only these can collide with programs already running on your machine.
# Inside Docker the services always use 5432 and 6379 regardless of what you set here.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
APP_HOST_PORT=8001

# Where the app looks for tasks. Unset it and tasks fall back to memory.
# This value is for running the app on your machine (uvicorn) against the container's published
# port. Inside compose the app service overrides it with the db hostname on the internal network.
DATABASE_URL=postgresql://tasks:change_me_locally@localhost:5433/tasks
REDIS_URL=redis://localhost:6379
